{
  "name": "claude-agent-sdk-lesson-01",
  "version": "1.0.0",
  "private": true,
  "description": "An interactive Lesson 1 lab for Claude Agent SDK TypeScript version 0.3.310.",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js --production",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/lesson.test.ts test/server.test.ts",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write .",
    "demo:cli": "tsx src/examples/first-query.ts --demo",
    "live:cli": "tsx src/examples/first-query.ts",
    "package-map": "tsx src/examples/package-map.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
